{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "speech workspace",
  "version": "0.12.0",
  "identifier": "com.spanvisioninfra.speechworkspace",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3025",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "speech workspace — Spanvision Infra",
        "width": 900,
        "height": 640,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "visible": false,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../bin/*",
      "../bin/cpu/*",
      "../models/ggml-base.bin",
      "../models/ggml-small.bin"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Dutch"
        ],
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "libxdo3",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libappindicator3-1",
          "curl"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "Spanvision Infra"
  },
  "plugins": {},
  "mainBinaryName": "spanvision-speech-workspace"
}
