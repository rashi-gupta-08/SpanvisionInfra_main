<?xml version='1.0' encoding='UTF-8'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='CAD'
    UpgradeCode='bd6bceab-6c7a-4ce2-a62d-6ef06a92f8b1'
    Manufacturer='Spanvision Infra'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package
      Id='*'
      Keywords='!(loc.Installer)'
      Description='!(loc.InstallerDescription)'
      Manufacturer='Spanvision Infra'
      InstallerVersion='450'
      Languages='1033'
      Compressed='yes'
      InstallScope='perMachine'
      SummaryCodepage='1252' />

    <MajorUpgrade
      Schedule='afterInstallInitialize'
      DowngradeErrorMessage='!(loc.DowngradeError)' />

    <Media Id='1' Cabinet='product.cab' EmbedCab='yes' />

    <Icon Id='AppIcon.ico' SourceFile='$(var.Icon)' />
    <Property Id='ARPPRODUCTICON' Value='AppIcon.ico' />
    <Property Id='ARPCONTACT' Value='Spanvision Infra' />
    <Property Id='ARPCOMMENTS' Value='!(loc.ApplicationDescription)' />
    <Property Id='ARPNOREPAIR' Value='1' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONROOTDIRECTORY' Name='CAD'>

          <Component Id='MainExecutable' Guid='2900c116-e9a5-4650-8a4c-48c0987d1a33' Win64='yes'>
            <File
              Id='SpanvisionCADEXE'
              Name='SpanvisionCAD.exe'
              DiskId='1'
              Source='$(var.Source)'
              KeyPath='yes'>
              <Shortcut
                Id='StartMenuShortcut'
                Directory='ProgramMenuDir'
                Name='CAD'
                Description='!(loc.Launch)'
                WorkingDirectory='APPLICATIONROOTDIRECTORY'
                Icon='AppIcon.ico'
                IconIndex='0'
                Advertise='yes' />
            </File>
            <File Id='LegacyExecutable' Name='OpenCADStudio.exe' DiskId='1' Source='$(var.Source)' />
            <File Id='LegalNotice' Name='NOTICE.md' DiskId='1' Source='NOTICE.md' />
            <File Id='DwgIco' Name='dwg.ico' DiskId='1' Source='packaging\windows\dwg.ico' />
            <File Id='DxfIco' Name='dxf.ico' DiskId='1' Source='packaging\windows\dxf.ico' />
            <File
              Id='DwgThumbDll'
              Name='dwg_thumbnailer_win.dll'
              DiskId='1'
              Source='target\release\dwg_thumbnailer_win.dll' />
            <ProgId
              Id='SpanvisionCAD.DWG'
              Description='!(loc.DwgDrawing)'
              Icon='DwgIco'
              IconIndex='0'>
              <Extension Id='dwg' ContentType='image/vnd.dwg'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='SpanvisionCADEXE' Argument='"%1"' />
              </Extension>
            </ProgId>

            <ProgId
              Id='SpanvisionCAD.DXF'
              Description='!(loc.DxfDrawing)'
              Icon='DxfIco'
              IconIndex='0'>
              <Extension Id='dxf' ContentType='image/vnd.dxf'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='SpanvisionCADEXE' Argument='"%1"' />
              </Extension>
            </ProgId>
          </Component>
          <Component Id='DefaultPrograms' Guid='6f3e9b2a-1c4d-4f8a-9b7e-2d5a8c1f0e63' Win64='yes'>
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SpanvisionCAD.exe\DefaultIcon'
              Type='string'
              Value='[APPLICATIONROOTDIRECTORY]SpanvisionCAD.exe,0'
              KeyPath='yes' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SpanvisionCAD.exe'
              Name='FriendlyAppName'
              Type='string'
              Value='CAD' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SpanvisionCAD.exe\shell\open\command'
              Type='string'
              Value='"[APPLICATIONROOTDIRECTORY]SpanvisionCAD.exe" "%1"' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SpanvisionCAD.exe\SupportedTypes'
              Name='.dwg'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SpanvisionCAD.exe\SupportedTypes'
              Name='.dxf'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='Software\CAD\Capabilities'
              Name='ApplicationName'
              Type='string'
              Value='CAD' />
            <RegistryValue
              Root='HKLM'
              Key='Software\CAD\Capabilities'
              Name='ApplicationDescription'
              Type='string'
              Value='!(loc.ApplicationDescription)' />
            <RegistryValue
              Root='HKLM'
              Key='Software\CAD\Capabilities\FileAssociations'
              Name='.dwg'
              Type='string'
              Value='SpanvisionCAD.DWG' />
            <RegistryValue
              Root='HKLM'
              Key='Software\CAD\Capabilities\FileAssociations'
              Name='.dxf'
              Type='string'
              Value='SpanvisionCAD.DXF' />
            <RegistryValue
              Root='HKLM'
              Key='Software\RegisteredApplications'
              Name='CAD'
              Type='string'
              Value='Software\CAD\Capabilities' />
          </Component>

        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ProgramMenuDir' Name='CAD'>
          <Component Id='ProgramMenuDirComp' Guid='34a788ba-f9d4-4e73-b1ff-9eb8749b369e'>
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue
              Root='HKCU'
              Key='Software\CAD'
              Name='installed'
              Type='integer'
              Value='1'
              KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>
      <Directory Id='DesktopFolder' Name='!(loc.Desktop)'>
        <Component Id='DesktopShortcutComp' Guid='c5c7f1c4-3d8a-4efd-b049-4662d9143dcd'>
          <Shortcut
            Id='DesktopShortcut'
            Name='CAD'
            Description='!(loc.Launch)'
            Target='[APPLICATIONROOTDIRECTORY]SpanvisionCAD.exe'
            WorkingDirectory='APPLICATIONROOTDIRECTORY'
            Icon='AppIcon.ico'
            IconIndex='0' />
          <RegistryValue
            Root='HKCU'
            Key='Software\CAD'
            Name='desktop_shortcut'
            Type='integer'
            Value='1'
            KeyPath='yes' />
        </Component>
      </Directory>
    </Directory>

    <Feature Id='Complete' Title='CAD' Level='1' Display='expand'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='DefaultPrograms' />
      <ComponentRef Id='ProgramMenuDirComp' />
      <Feature
        Id='DesktopShortcut'
        Title='!(loc.DesktopShortcut)'
        Description='!(loc.DesktopShortcutDescription)'
        Level='1'
        Absent='allow'>
        <ComponentRef Id='DesktopShortcutComp' />
      </Feature>
    </Feature>
    <UIRef Id='SpanvisionCADUI' />

  </Product>
</Wix>
