{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Field Workspace",
  "version": "0.3.6",
  "identifier": "com.spanvisioninfra.fieldworkspace",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4245",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Field Workspace — Spanvision Infra",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Spanvision Infra",
    "shortDescription": "Construction inspection, handover and quality assurance",
    "resources": {
      "../legal/": "legal/"
    }
  },
  "mainBinaryName": "spanvision-field-workspace"
}
